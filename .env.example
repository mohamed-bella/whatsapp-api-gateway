# Environment mode (development, production, test)
NODE_ENV=production

# Server binding
PORT=3000
HOST=0.0.0.0

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres_secure_pass@postgres:5432/whatsapp_gateway?schema=public

# Persistent authentication directory for Baileys Signal keys and auth creds
AUTH_DIR=/data/baileys-auth

# Webhook configuration for forwarding incoming WhatsApp customer messages
WEBHOOK_URL=https://your-business-app.com/api/webhooks/whatsapp
WEBHOOK_SECRET=your_super_secret_hmac_key_here

# Security & Dashboard Admin
DASHBOARD_PASSWORD=change_this_to_a_secure_admin_password
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# WhatsApp Outbound Dispatch Throttling (messages per second to prevent WhatsApp bans)
MESSAGE_RATE_LIMIT_PER_SEC=5
MAX_RETRIES=3

# Logging level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
